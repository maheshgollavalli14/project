{
  "name": "codebreak",
  "version": "1.0.0",
  "private": true,
  "description": "CODEBREAK — College Programming Contest Platform",
  "scripts": {
    "db:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-db.ps1",
    "db:stop": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-db.ps1",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "install:server": "npm --prefix server install --include=dev",
    "install:client": "npm --prefix client install --include=dev",
    "install:all": "npm run install:server && npm run install:client",
    "prebuild": "npm run install:all",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "start": "npm --prefix server start",
    "test:server": "npm --prefix server test"
  },
  "keywords": [
    "competitive-programming",
    "hackathon",
    "contest",
    "react",
    "express",
    "prisma",
    "socketio"
  ],
  "author": "CODEBREAK Team",
  "license": "MIT"
}
