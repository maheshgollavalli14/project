# ==========================================
# CODEBREAK Platform Environment Template
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
# Dedicated local cluster runs on port 5433 by default
DATABASE_URL=postgresql://postgres@localhost:5433/codebreak?schema=public

# Authentication & Security
JWT_SECRET=super_secret_codebreak_jwt_key_2026_dev_secure
JWT_EXPIRES_IN=24h
COOKIE_SECRET=codebreak_cookie_signing_secret_phrase

# Rate Limiting & Safety
MAX_SUBMISSIONS_PER_MINUTE=20
EXECUTION_TIMEOUT_MS=3000

# Sandbox Paths (Optional override)
RUNNER_TEMP_DIR=
