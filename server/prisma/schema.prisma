generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICIPANT
  ADMIN
}

enum ContestStatus {
  UPCOMING
  ACTIVE
  PAUSED
  COMPLETED
}

enum RoundStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum RoundType {
  MCQ_OUTPUT_CODING
  DEBUGGING_JUMBLED
  FINAL_CODING
}

enum QuestionType {
  MCQ
  OUTPUT_PREDICTION
  DEBUGGING
  JUMBLED
  CODING
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  COMPILATION_ERROR
  RUNTIME_ERROR
}

enum ViolationType {
  FULLSCREEN_EXIT
  TAB_SWITCH
  WINDOW_BLUR
  COPY
  PASTE
  CUT
  CONTEXT_MENU
  SUSPICIOUS_KEYBOARD_SHORTCUT
  NAVIGATION_ATTEMPT
  MULTIPLE_LOGIN
  INVALID_SUBMISSION_ATTEMPT
  OTHER_SUSPICIOUS_ACTIVITY
  SUSPICIOUS_ACTIVITY
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ParticipantRoundStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  LOCKED
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  role         Role        @default(PARTICIPANT)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  profile      Profile?
  submissions  Submission[]
  savedCodes   SavedCode[]
  scores       Score[]
  violations   Violation[]
  payments     Payment[]
  sessions     UserSession[]
  roundProgress ParticipantRoundProgress[]

  @@index([email])
}

model Profile {
  id             String            @id @default(uuid())
  userId         String            @unique
  fullName       String
  college        String
  phone          String
  participantId  String            @unique
  avatarUrl      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Contest {
  id                  String         @id @default(uuid())
  title               String         @default("CODEBREAK 2026")
  tagline             String         @default("BREAK THE CODE WITHIN YOU")
  description         String
  status              ContestStatus  @default(UPCOMING)
  registrationOpen    Boolean        @default(true)
  registrationFee     Float          @default(150.0)
  qualificationCutoff Int            @default(20)
  rules               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  rounds              ContestRound[]
  scores              Score[]
  violations          Violation[]
}

model ContestRound {
  id              String       @id @default(uuid())
  contestId       String
  roundNumber     Int          // 1, 2, 3
  title           String       // e.g. "Round 1: MCQs & Code Logic"
  description     String
  type            RoundType
  startTime       DateTime?
  endTime         DateTime?
  durationMinutes Int          @default(45)
  status          RoundStatus  @default(UPCOMING)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  contest         Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  questions       Question[]
  submissions     Submission[]
  scores          Score[]
  participantProgress ParticipantRoundProgress[]

  @@unique([contestId, roundNumber])
}

model Question {
  id               String           @id @default(uuid())
  roundId          String
  orderNumber      Int              @default(1)
  title            String
  description      String           // Markdown statement
  type             QuestionType
  difficulty       Difficulty       @default(EASY)
  points           Int              @default(10)
  timeLimitMs      Int              @default(2000)
  memoryLimitMb    Int              @default(128)
  initialCode      String?          // Starter code or jumbled snippet
  expectedOutput   String?          // For output prediction / debugging
  constraints      String?
  allowedLanguages String           @default("python,java,cpp")
  isPublished      Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  round            ContestRound     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  options          QuestionOption[]
  testCases        TestCase[]
  submissions      Submission[]
  savedCodes       SavedCode[]

  @@index([roundId])
}

model QuestionOption {
  id          String   @id @default(uuid())
  questionId  String
  text        String
  isCorrect   Boolean  @default(false)
  explanation String?
  orderNumber Int      @default(1)

  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model TestCase {
  id             String   @id @default(uuid())
  questionId     String
  input          String
  expectedOutput String
  isPublic       Boolean  @default(false) // true = Sample Test, false = Hidden Official Test
  weight         Int      @default(1)
  createdAt      DateTime @default(now())

  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Submission {
  id           String           @id @default(uuid())
  questionId   String
  userId       String
  roundId      String
  language     String           // python, java, cpp, text
  code         String
  status       SubmissionStatus @default(PENDING)
  score        Int              @default(0)
  runtimeMs    Int?
  memoryKb     Int?
  passedTests  Int              @default(0)
  totalTests   Int              @default(0)
  errorOutput  String?
  createdAt    DateTime         @default(now())

  question     Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  round        ContestRound     @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
}

model SavedCode {
  id               String    @id @default(uuid())
  questionId       String
  userId           String
  code             String?
  language         String?
  selectedOptionId String?
  markedForReview  Boolean   @default(false)
  updatedAt        DateTime  @updatedAt

  question         Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model Score {
  id             String        @id @default(uuid())
  contestId      String
  roundId        String?
  userId         String
  points         Int           @default(0)
  solvedCount    Int           @default(0)
  penaltySeconds Int           @default(0)
  isQualified    Boolean       @default(false)
  rank           Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  contest        Contest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  round          ContestRound? @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, roundId, userId])
  @@index([contestId, points, penaltySeconds])
}

model Violation {
  id         String        @id @default(uuid())
  userId     String
  contestId  String?
  roundId    String?
  questionId String?
  type       ViolationType
  severity   Severity      @default(LOW)
  metadata   String?       // JSON string with extra details like timestamp, key info
  reviewed   Boolean       @default(false)
  adminNote  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now()) @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest    Contest?      @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([contestId])
  @@index([roundId])
  @@index([questionId])
}

model Payment {
  id            String        @id @default(uuid())
  userId        String
  amount        Float
  currency      String        @default("INR")
  transactionId String        @unique
  status        PaymentStatus @default(COMPLETED)
  provider      String        @default("MOCK_GATEWAY")
  createdAt     DateTime      @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorEmail String
  action     String   // e.g. "START_ROUND", "OVERRIDE_SCORE", "UPDATE_QUESTION"
  entity     String   // e.g. "ContestRound", "Score", "Question"
  entityId   String?
  metadata   String?  // JSON string
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
}

model ContestSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model UserSession {
  id             String    @id @default(uuid())
  userId         String
  sessionToken   String    @unique @default(uuid())
  userAgent      String?
  ipAddress      String?
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  isActive       Boolean   @default(true)

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([sessionToken])
}

model ParticipantRoundProgress {
  id           String                 @id @default(uuid())
  userId       String
  roundId      String
  status       ParticipantRoundStatus @default(NOT_STARTED)
  startedAt    DateTime?
  submittedAt  DateTime?
  lockedAt     DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  round        ContestRound           @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([userId, roundId])
  @@index([userId, status])
  @@index([roundId])
}


